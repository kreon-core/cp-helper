{
  "manifest_version": 3,
  "name": "CP Topic Picker",
  "version": "1.0.0",
  "description": "Randomly pick one competitive programming topic to practice each day.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CP Topic Picker",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"]
}
