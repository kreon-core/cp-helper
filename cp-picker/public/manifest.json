{
  "manifest_version": 3,
  "name": "CP Picker",
  "version": "1.0.4",
  "description": "Pick a Codeforces or AtCoder problem to practice each day, by category and problem type.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "CP Picker",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": ["https://codeforces.com/api/*", "https://kenkoooo.com/atcoder/resources/*"]
}
